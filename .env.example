MOODLE_BASE_URL=http://localhost:8080

# Controlled local Moodle credentials. Blank teacher/student passwords are filled
# by the seed/env sync path with the documented local-only demo password.
MOODLE_ADMIN_USERNAME=user
MOODLE_ADMIN_PASSWORD=changeme
MOODLE_TEACHER_USERNAME=teacher.qa
MOODLE_TEACHER_PASSWORD=
MOODLE_STUDENT_USERNAME=student.qa
MOODLE_STUDENT_PASSWORD=
MOODLE_STUDENT_EMAIL=student.qa@example.test
MOODLE_MANAGER_USERNAME=manager.qa
MOODLE_MANAGER_PASSWORD=changeme
MOODLE_API_TOKEN=
MOODLE_COURSE_NAME=QA Automation Demo 101
MOODLE_ASSIGNMENT_NAME=Essay: Test Automation Strategy
MOODLE_AUDIO_RESOURCE_NAME=Sample Listening Task
MOODLE_TARGET_GRADE=82

# Generated by `npm run moodle:seed` and applied by `npm run moodle:seed:env`.
# Leave blank for a fresh local setup; manual ID collection is not required.
MOODLE_COURSE_ID=
MOODLE_ASSIGNMENT_ID=
MOODLE_ASSIGNMENT_GRADE_ITEM_ID=
MOODLE_STUDENT_ID=
MOODLE_SUBMISSION_ID=
MOODLE_COURSE_URL=
MOODLE_ASSIGNMENT_URL=
MOODLE_ASSIGNMENT_SUBMISSIONS_URL=
MOODLE_ASSIGNMENT_GRADING_URL=
MOODLE_GRADEBOOK_URL=
MOODLE_STUDENT_DISPLAY_NAME=Student QA

UI_EXPECT_TIMEOUT_MS=10000

# Primary runtime profile model. Prefer these MOODLE_* variables for local
# review, CI-safe fast checks, tracing, video, terminal output, and screencast.
MOODLE_EXECUTION_PROFILE=fast
MOODLE_HEADLESS=
MOODLE_SLOW_MO_MS=
MOODLE_STEP_DELAY_MS=
MOODLE_SCREENCAST=
MOODLE_TRACE_MODE=
MOODLE_VIDEO_MODE=
MOODLE_TERMINAL_STEPS=
MOODLE_READY_TIMEOUT_MS=180000

# Legacy compatibility/deprecated variables. Prefer the MOODLE_* runtime variables above.
HEADLESS=true
TRACE_MODE=retain-on-failure
TRACE_ON_FAILURE=true
VIDEO_ON_FAILURE=true

MOODLE_ADMIN_EMAIL=admin@example.test
MOODLE_DB_ROOT_PASSWORD=changeme
MOODLE_DB_USER=bn_moodle
MOODLE_DB_PASSWORD=changeme
MOODLE_DB_NAME=bitnami_moodle
MOODLE_DOCKER_IMAGE=bitnamilegacy/moodle:latest
MARIADB_DOCKER_IMAGE=bitnamilegacy/mariadb:11.4
