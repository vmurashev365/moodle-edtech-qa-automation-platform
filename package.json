{
  "name": "moodle-edtech-qa-automation-platform",
  "version": "0.3.0",
  "private": true,
  "description": "Cucumber-first Playwright TypeScript automation skeleton for controlled Moodle teacher workflows.",
  "scripts": {
    "test:smoke": "cucumber-js --profile smoke",
    "test:web": "cucumber-js --profile web",
    "test:e2e": "cucumber-js --profile e2e",
    "test:api": "cucumber-js --profile api",
    "test:security": "cucumber-js --profile security",
    "test:media": "cucumber-js --profile media",
    "test:all": "cucumber-js --profile all",
    "test:wip": "cucumber-js --profile wip",
    "test:local:smoke": "cucumber-js --profile smoke --tags \"@phase4 and @local and not @wip\"",
    "test:local:teacher-workflow": "cucumber-js --profile e2e --tags \"@phase5 and @local and not @wip\"",
    "check:local:grading-readiness": "ts-node scripts/check-grading-data.ts",
    "test:local:grading": "ts-node scripts/check-grading-data.ts && ts-node scripts/run-cucumber-with-scenario-guard.ts --profile e2e --tags \"@phase6 and @local and not @wip\" --name test-local-grading",
    "install:browsers": "playwright install chromium",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "report:allure": "allure generate reports/allure-results --clean -o reports/allure-report",
    "report:allure:open": "allure open reports/allure-report",
    "clean:reports": "node -e \"const fs=require('fs'); for (const target of ['reports','test-results','allure-results','allure-report','screenshots','videos','traces']) fs.rmSync(target,{recursive:true,force:true});\"",
    "clean:artifacts": "node -e \"const fs=require('fs'); for (const target of ['artifacts','screenshots','videos','traces']) fs.rmSync(target,{recursive:true,force:true});\"",
    "clean:local": "npm run clean:reports && npm run clean:artifacts",
    "docker:start": "docker compose up -d",
    "docker:stop": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "moodle:start": "docker compose up -d",
    "moodle:stop": "docker compose down",
    "moodle:reset": "docker compose down -v && docker compose up -d",
    "moodle:logs": "docker compose logs -f moodle mariadb",
    "moodle:wait": "ts-node scripts/wait-for-moodle.ts",
    "moodle:seed": "ts-node scripts/seed-controlled-moodle.ts",
    "moodle:seed:env": "ts-node scripts/apply-seed-env.ts",
    "moodle:seed:ready": "npm run moodle:seed && npm run moodle:seed:env && npm run check:data && npm run check:grading-data",
    "verify:env": "ts-node scripts/verify-env.ts",
    "check:data": "ts-node scripts/check-controlled-data.ts",
    "check:grading-data": "ts-node scripts/check-grading-data.ts",
    "seed:placeholder": "ts-node scripts/seed-placeholder.ts",
    "clean:placeholder": "ts-node scripts/clean-placeholder.ts"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.4",
    "allure-commandline": "^2.41.0",
    "allure-cucumberjs": "^3.8.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.4",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
